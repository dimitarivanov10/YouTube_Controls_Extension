{
  "manifest_version": 3,
  "name": "Dev Warmup Tools",
  "version": "1.0.0",
  "permissions": ["activeTab", "cookies", "scripting"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["src/scripts/content.js"]
    }
  ]
}
